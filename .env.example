# ── Database ──────────────────────────────────────────────
# Connection string for the homelab Postgres (cleartext, no TLS).
# WARNING: credentials travel unencrypted on the LAN.
DATABASE_URL=postgresql://patente_quiz_app:CHANGE_ME@192.168.2.105:5432/patente_quiz

# ── LLM (Ollama Cloud API) ────────────────────────────────
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_MODEL=deepseek-v4-flash
OLLAMA_HOST=https://ollama.com

# ── Auth ──────────────────────────────────────────────────
# Secret used to sign session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# The single user created on first run.
INITIAL_USERNAME=gabry

# ── App ───────────────────────────────────────────────────
# Bind address inside the container.
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated origins for CORS (usually empty when behind tunnel).
CORS_ORIGINS=